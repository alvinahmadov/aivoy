# Local demo mode: all providers are local/free by default.
# No paid API keys are required to run the project.

ENV=local

# JWT
JWT_SECRET=dev-secret-change-me

# Database (async SQLAlchemy DSN, matches docker-compose postgres service)
POSTGRES_DSN=postgresql+asyncpg://app:app@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379/0

# Lifetime of short-lived WebSocket tickets, in seconds
WS_TICKET_TTL_SECONDS=60

# Rate limits (per tenant, except the signup limit, which is per client address)
# Requests per minute on the REST routes. Exceeding it answers 429 with Retry-After.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Signup attempts (POST /tenants) per minute per address — the unauthenticated
# route that mints credentials.
RATE_LIMIT_TENANT_CREATION_PER_MINUTE=30
# Calls a tenant may have open at once. The next one is closed with 4429.
WS_MAX_CONCURRENT_SESSIONS=3
# Seconds of silence before a call is closed with 4408. Doubled internally as the
# TTL on the slot counter, so a slot lost to a hard kill comes back on its own.
WS_IDLE_TIMEOUT_SECONDS=120

# Providers
# whisper | deepgram
STT_PROVIDER=whisper
# piper | elevenlabs
TTS_PROVIDER=piper
# ollama | grok | gemini | fake
LLM_PROVIDER=ollama
# local | vertex
EMBEDDINGS_PROVIDER=local
# local | s3
STORAGE_PROVIDER=local

# API Keys (empty in local mode; required only for the cloud providers above)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
GROK_API_KEY=
# Vertex AI project (cloud embeddings adapter)
GEMINI_PROJECT_ID=
# Gemini API key from AI Studio, sent as the x-goog-api-key header
GEMINI_API_KEY=
AWS_REGION=
# In production (`ENV=production`) the keys above are read from AWS Secrets
# Manager instead of the environment, under this prefix: a secret named
# DEEPGRAM_API_KEY is fetched from <prefix>deepgram_api_key.
AWS_SECRET_PREFIX=voice-agent/

# LLM models and endpoints
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GROK_MODEL=grok-4.7
GEMINI_MODEL=gemini-3.5-flash

# Local STT (faster-whisper, free, no key).
# NOT true streaming: it is batch STT behind an amplitude VAD, so a transcript
# only exists once you stop talking. See README "Limitations".
# tiny | base | small | medium | large-v3 (accuracy/speed trade-off, base ≈ 75 MB)
WHISPER_MODEL=base
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# int8 on CPU, float16 on GPU
WHISPER_COMPUTE_TYPE=int8
# Leave empty to let Whisper detect the language
WHISPER_LANGUAGE=

# Local TTS (piper, free, no key). Not a model download: a voice is a separate
# *.onnx file. Either point PIPER_MODEL_PATH at one, or set PIPER_VOICE and the
# adapter fetches it once from the rhasspy/piper-voices Hugging Face repository.
# e.g. PIPER_VOICE=en_US-amy-low (16 kHz, fastest) or en_US-lessac-medium
PIPER_MODEL_PATH=
PIPER_VOICE=en_US-lessac-medium
# > 1 speaks slower, < 1 speaks faster
PIPER_LENGTH_SCALE=1.0
# Where a downloaded voice is cached; empty = the Hugging Face default cache
PIPER_DOWNLOAD_DIR=

# Cloud STT/TTS (Deepgram / ElevenLabs). Only used when the provider above says so.
DEEPGRAM_MODEL=nova-3
# Silence in ms that commits a transcript
DEEPGRAM_ENDPOINTING_MS=300
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Raw PCM16 — the only format the browser AudioWorklet can play directly
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
